Window.SetBackgroundTopColor(0.008, 0.035, 0.067);
Window.SetBackgroundBottomColor(0.004, 0.016, 0.031);

logo_image = Image("waykeeper.png");
logo_image = logo_image.Scale(220, 264);
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2 - 24);

room_image = Image.Text("WAYKEEPER // ROOM WK-01", 0.18, 0.72, 1.0);
room_sprite = Sprite(room_image);
room_sprite.SetX(Window.GetWidth() / 2 - room_image.GetWidth() / 2);
room_sprite.SetY(Window.GetHeight() - 72);

progress_image = Image.Text("BOOTING OFFLINE ANSI CORE", 0.96, 0.76, 0.28);
progress_sprite = Sprite(progress_image);
progress_sprite.SetX(Window.GetWidth() / 2 - progress_image.GetWidth() / 2);
progress_sprite.SetY(Window.GetHeight() - 44);
